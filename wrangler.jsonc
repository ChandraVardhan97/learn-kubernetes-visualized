{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kubernetes-visualized",
  "compatibility_date": "2026-10-27",
  "previews": {},
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": { "directory": "./dist", "not_found_handling": "404-page" }
}
