  {
    "title": "A scheduled run contains retryable attempts",
    "kind": "queue",
    "description": "Follow CronJob scheduling into a Job, a failed attempt and a successful retry with duplicate side-effect risk.",
    "assumption": "One CronJob and finite work; no exactly-once business guarantee.",
    "frames": [
      {
        "title": "Trigger a Job",
        "narration": "The CronJob evaluates its schedule and concurrency policy, then creates a Job for an eligible run.",
        "nodes": [
          {
            "id": "0",
            "label": "CronJob",
            "detail": "Schedule + concurrencyPolicy",
            "type": "control",
            "state": "active"
          },
          {
            "id": "1",
            "label": "Job run",
            "detail": "Completion and retry budget",
            "type": "object",
            "state": "active"
          },
          {
            "id": "2",
            "label": "Attempt 1",
            "detail": "Writes then exits unsuccessfully",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "3",
            "label": "Attempt 2",
            "detail": "Replacement attempt",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Result store",
            "detail": "Requires idempotency key",
            "type": "storage",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "0",
            "to": "1",
            "label": "scheduled run",
            "state": "active"
          }
        ]
      },
      {
        "title": "Run the first attempt",
        "narration": "The Job starts a Pod. It may produce an external side effect before its final exit status is known.",
        "nodes": [
          {
            "id": "0",
            "label": "CronJob",
            "detail": "Schedule + concurrencyPolicy",
            "type": "control",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Job run",
            "detail": "Completion and retry budget",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "Attempt 1",
            "detail": "Writes then exits unsuccessfully",
            "type": "pod",
            "state": "active"
          },
          {
            "id": "3",
            "label": "Attempt 2",
            "detail": "Replacement attempt",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Result store",
            "detail": "Requires idempotency key",
            "type": "storage",
            "state": "active"
          }
        ],
        "edges": [
          {
            "from": "1",
            "to": "2",
            "label": "attempt",
            "state": "active"
          },
          {
            "from": "2",
            "to": "4",
            "label": "write result",
            "state": "active"
          }
        ]
      },
      {
        "title": "Retry a failed attempt",
        "narration": "A failure within backoffLimit can create another attempt. The controller does not know whether the previous external write was committed.",
        "nodes": [
          {
            "id": "0",
            "label": "CronJob",
            "detail": "Schedule + concurrencyPolicy",
            "type": "control",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Job run",
            "detail": "Completion and retry budget",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "Attempt 1",
            "detail": "Writes then exits unsuccessfully",
            "type": "pod",
            "state": "failed"
          },
          {
            "id": "3",
            "label": "Attempt 2",
            "detail": "Replacement attempt",
            "type": "pod",
            "state": "active"
          },
          {
            "id": "4",
            "label": "Result store",
            "detail": "Requires idempotency key",
            "type": "storage",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "1",
            "to": "3",
            "label": "retry",
            "state": "active"
          },
          {
            "from": "2",
            "to": "1",
            "label": "failed",
            "state": "blocked"
          }
        ]
      },
      {
        "title": "Complete idempotently",
        "narration": "The second attempt uses the same business work key so the destination can deduplicate the result, then Job completion is recorded.",
        "nodes": [
          {
            "id": "0",
            "label": "CronJob",
            "detail": "Schedule + concurrencyPolicy",
            "type": "control",
            "state": "idle"
          },
          {
            "id": "1",
