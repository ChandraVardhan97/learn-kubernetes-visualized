            "type": "object",
            "state": "ready"
          },
          {
            "id": "2",
            "label": "Attempt 1",
            "detail": "Writes then exits unsuccessfully",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "3",
            "label": "Attempt 2",
