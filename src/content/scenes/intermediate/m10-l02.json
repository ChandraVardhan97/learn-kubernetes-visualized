            "type": "pod",
            "state": "ready"
          },
          {
            "id": "4",
            "label": "Result store",
            "detail": "Requires idempotency key",
            "type": "storage",
            "state": "ready"
          }
        ],
        "edges": [
          {
            "from": "3",
            "to": "4",
            "label": "same work key",
            "state": "active"
          },
          {
            "from": "3",
            "to": "1",
            "label": "succeeded",
            "state": "active"
          }
        ]
      }
    ],
