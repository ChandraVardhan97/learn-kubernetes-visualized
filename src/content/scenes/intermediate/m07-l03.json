[
  {
    "title": "Count domains before choosing the next placement",
    "kind": "scheduling",
    "description": "Compare two zone counts as a fourth replica is scheduled and explain a hard-skew failure.",
    "assumption": "Two eligible zones with consistent labels; examples omit advanced minDomains and inclusion-policy settings.",
    "frames": [
      {
        "title": "Count matching replicas",
        "narration": "The selector counts api Pods, not every Pod in the namespace. The current eligible zone counts are east=2 and west=1.",
        "nodes": [
          {
            "id": "0",
            "label": "New api Pod",
            "detail": "Selector counts app=api replicas",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Zone east",
            "detail": "Two matching Pods",
            "type": "node",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "Zone west",
            "detail": "One matching Pod",
            "type": "node",
            "state": "idle"
          },
          {
            "id": "3",
            "label": "Scheduler",
            "detail": "maxSkew=1; DoNotSchedule",
            "type": "control",
            "state": "active"
          }
        ],
        "edges": [
          {
            "from": "1",
            "to": "3",
            "label": "count 2",
            "state": "active"
          },
          {
            "from": "2",
            "to": "3",
            "label": "count 1",
            "state": "active"
          }
        ]
      },
      {
        "title": "Test the crowded zone",
        "narration": "Putting the new replica in east creates counts 3 and 1. Skew 2 exceeds the configured maximum 1.",
        "nodes": [
          {
            "id": "0",
            "label": "New api Pod",
            "detail": "Selector counts app=api replicas",
            "type": "pod",
            "state": "active"
          },
          {
            "id": "1",
            "label": "Zone east",
            "detail": "Two matching Pods",
            "type": "node",
            "state": "warning"
          },
          {
            "id": "2",
            "label": "Zone west",
            "detail": "One matching Pod",
            "type": "node",
            "state": "idle"
          },
          {
            "id": "3",
            "label": "Scheduler",
            "detail": "maxSkew=1; DoNotSchedule",
            "type": "control",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "0",
            "to": "1",
            "label": "3 versus 1",
            "state": "blocked"
          }
        ]
      },
      {
        "title": "Test the less crowded zone",
        "narration": "Putting it in west creates counts 2 and 2, so this topology constraint allows the placement.",
        "nodes": [
          {
            "id": "0",
            "label": "New api Pod",
            "detail": "Selector counts app=api replicas",
            "type": "pod",
            "state": "active"
          },
          {
            "id": "1",
            "label": "Zone east",
            "detail": "Two matching Pods",
            "type": "node",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "Zone west",
            "detail": "One matching Pod",
            "type": "node",
            "state": "ready"
          },
          {
            "id": "3",
            "label": "Scheduler",
            "detail": "maxSkew=1; DoNotSchedule",
            "type": "control",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "0",
            "to": "2",
            "label": "2 versus 2",
            "state": "active"
          }
        ]
      },
      {
        "title": "Bind after other filters",
        "narration": "The scheduler can choose a fitting west node after all other resource and placement rules pass. Existing Pods do not move merely because this rule exists.",
        "nodes": [
          {
            "id": "0",
            "label": "New api Pod",
            "detail": "Selector counts app=api replicas",
            "type": "pod",
            "state": "ready"
