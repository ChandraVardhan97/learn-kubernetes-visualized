          {
            "title": "Choose capacity or a softer rule",
            "narration": "Add fitting capacity in west or deliberately choose ScheduleAnyway when temporary imbalance is acceptable.",
            "nodes": [
              {
                "id": "0",
                "label": "New api Pod",
                "detail": "Selector counts app=api replicas",
                "type": "pod",
                "state": "idle"
              },
              {
                "id": "1",
                "label": "Zone east",
                "detail": "Two matching Pods",
                "type": "node",
                "state": "idle"
              },
              {
                "id": "2",
                "label": "Zone west",
                "detail": "One matching Pod",
                "type": "node",
                "state": "idle"
              },
              {
                "id": "3",
                "label": "Scheduler",
                "detail": "maxSkew=1; DoNotSchedule",
                "type": "control",
                "state": "active"
              }
            ],
            "edges": [
              {
                "from": "0",
                "to": "3",
                "label": "policy decision",
                "state": "active"
              }
            ],
            "code": "whenUnsatisfiable: ScheduleAnyway"
          }
        ]
