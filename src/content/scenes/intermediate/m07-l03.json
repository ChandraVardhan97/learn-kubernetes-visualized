  {
    "title": "Admission budget precedes placement",
    "kind": "policy",
    "description": "Follow LimitRange mutation into ResourceQuota accounting and then scheduler placement.",
    "assumption": "One namespace and one CPU request budget; real quotas can track many resources.",
    "frames": [
      {
        "title": "Submit incomplete resources",
        "narration": "The submitted Pod has no CPU request, but admission has not yet completed.",
        "nodes": [
          {
            "id": "0",
            "label": "Submitted Pod",
            "detail": "CPU request omitted",
            "type": "object",
            "state": "active"
          },
          {
            "id": "1",
            "label": "LimitRange",
            "detail": "Default CPU request 100m",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "ResourceQuota",
            "detail": "1 CPU hard; 950m already used",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "3",
            "label": "API admission",
            "detail": "Mutate, validate, persist",
            "type": "control",
            "state": "active"
          },
          {
            "id": "4",
            "label": "Scheduler",
            "detail": "Uses admitted requests",
            "type": "control",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "0",
            "to": "3",
            "label": "create request",
            "state": "active"
          }
        ]
      },
      {
        "title": "Apply defaults",
        "narration": "LimitRange supplies a 100m CPU request, changing the amount quota and scheduling must account for.",
        "nodes": [
          {
            "id": "0",
            "label": "Defaulted Pod",
            "detail": "CPU request now 100m",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "LimitRange",
            "detail": "Default CPU request 100m",
            "type": "object",
            "state": "active"
          },
          {
            "id": "2",
            "label": "ResourceQuota",
            "detail": "1 CPU hard; 950m already used",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "3",
            "label": "API admission",
            "detail": "Mutate, validate, persist",
            "type": "control",
            "state": "active"
          },
          {
            "id": "4",
            "label": "Scheduler",
            "detail": "Uses admitted requests",
            "type": "control",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "1",
            "to": "3",
            "label": "default 100m",
            "state": "active"
          }
        ],
        "code": "defaultRequest:\n  cpu: 100m"
      },
      {
        "title": "Reject an over-budget create",
        "narration": "950m plus 100m exceeds the 1 CPU namespace quota. Admission rejects the Pod rather than leaving that Pod Pending.",
        "nodes": [
          {
            "id": "0",
            "label": "Rejected proposal",
            "detail": "Defaulted CPU request 100m; not persisted",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "LimitRange",
            "detail": "Default CPU request 100m",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "ResourceQuota",
            "detail": "1 CPU hard; 950m already used",
            "type": "object",
            "state": "warning"
          },
          {
            "id": "3",
            "label": "API admission",
            "detail": "Mutate, validate, persist",
            "type": "control",
            "state": "failed"
          },
          {
            "id": "4",
            "label": "Scheduler",
            "detail": "Uses admitted requests",
            "type": "control",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "3",
            "to": "2",
            "label": "1050m > 1000m",
            "state": "blocked"
          }
        ]
      },
      {
        "title": "Free budget then place",
        "narration": "After accounted requests fall sufficiently, a new create can pass quota. The scheduler still independently checks node capacity.",
        "nodes": [
          {
            "id": "0",
            "label": "New Pod create",
            "detail": "CPU request 100m; admitted after budget is freed",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "LimitRange",
            "detail": "Default CPU request 100m",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "ResourceQuota",
            "detail": "1 CPU hard; 800m already used before this create",
            "type": "object",
            "state": "ready"
          },
          {
            "id": "3",
            "label": "API admission",
            "detail": "Mutate, validate, persist",
            "type": "control",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Scheduler",
            "detail": "Uses admitted requests",
            "type": "control",
            "state": "active"
          }
        ],
        "edges": [
          {
            "from": "3",
            "to": "4",
            "label": "persisted Pod",
            "state": "active"
          }
        ],
        "code": "kubectl describe resourcequota team-budget"
      }
    ],
