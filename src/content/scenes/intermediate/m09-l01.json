  {
    "title": "One node is not one application writer",
    "kind": "storage",
    "description": "Explain ReadWriteOnce, ReadWriteOncePod and reclaim policy without promising application locking.",
    "assumption": "Driver supports the illustrated access mode; application consistency is outside mount admission.",
    "frames": [
      {
        "title": "Request an access arrangement",
        "narration": "ReadWriteOnce asks for read-write mounting on one node and must be supported by the volume.",
        "nodes": [
          {
            "id": "0",
            "label": "Pod A",
            "detail": "Writer on Node 1",
            "type": "pod",
            "state": "idle"
          },
