            "id": "3",
            "label": "PVC",
            "detail": "ReadWriteOnce",
            "type": "object",
            "state": "active"
          },
          {
            "id": "4",
            "label": "PV",
            "detail": "Reclaim policy Retain or Delete",
            "type": "storage",
            "state": "active"
