  {
    "title": "Three files, three lifetimes",
    "kind": "storage",
    "description": "Compare a container writable layer, emptyDir and PVC data during restart and Pod replacement.",
    "assumption": "Storage implementation remains available; the scene does not claim backup or node-loss recovery.",
    "frames": [
      {
        "title": "Write at explicit paths",
        "narration": "The same process can write to its own filesystem, a Pod-scoped emptyDir and a claim-backed mounted path.",
