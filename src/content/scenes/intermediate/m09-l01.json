            "id": "0",
            "label": "Container",
            "detail": "Instance can restart",
            "type": "pod",
            "state": "active"
          },
          {
            "id": "1",
            "label": "Writable layer",
            "detail": "Fresh for a restarted container",
            "type": "storage",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "emptyDir",
            "detail": "Belongs to this Pod",
            "type": "storage",
            "state": "idle"
