  {
    "title": "Bound, attached and mounted are separate checkpoints",
    "kind": "storage",
    "description": "Trace CSI controller and node responsibilities and explain driver-dependent expansion.",
    "assumption": "A CSI driver supporting controller attachment and node staging; drivers without those capabilities skip the corresponding checkpoints.",
    "frames": [
      {
        "title": "Bind the resource",
        "narration": "The claim binds to a PV naming the CSI driver and provider volume identity. Binding does not mount the filesystem.",
        "nodes": [
          {
            "id": "0",
            "label": "PVC + PV",
            "detail": "Bound storage identity",
            "type": "object",
            "state": "ready"
          },
