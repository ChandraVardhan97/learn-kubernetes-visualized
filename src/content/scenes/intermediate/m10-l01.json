  {
    "title": "Each member keeps a distinct claim and rollout checkpoint",
    "kind": "storage",
    "description": "Follow volumeClaimTemplates into per-ordinal claims and a readiness-gated rolling update.",
    "assumption": "Default OrderedReady management and default rolling-update behavior; retained PVCs.",
    "frames": [
      {
        "title": "Instantiate claims",
        "narration": "The template produces distinct claims such as data-ledger-0. The controller is not cloning one shared writable filesystem for every Pod.",
