  {
    "title": "One peer means AND; separate peers mean OR",
    "kind": "policy",
    "description": "Compare namespace and Pod selector combinations and validate enforcement with positive and negative probes.",
    "assumption": "Labels shown on the two source Pods and their namespaces are the only peer attributes used.",
    "frames": [
      {
        "title": "Select the destination",
        "narration": "Top-level podSelector selects the API Pods in the policy namespace; it does not select the clients.",
        "nodes": [
          {
            "id": "0",
            "label": "Shop frontend",
            "detail": "namespace team=shop; role=frontend",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Other frontend",
            "detail": "namespace team=other; role=frontend",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "Shop batch",
            "detail": "namespace team=shop; role=batch",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "3",
            "label": "API policy",
            "detail": "Namespace AND Pod selector",
            "type": "object",
            "state": "active"
          },
          {
            "id": "4",
            "label": "API Pod",
            "detail": "TCP 8080",
            "type": "pod",
            "state": "active"
          }
        ],
        "edges": [
          {
            "from": "3",
            "to": "4",
            "label": "app=api",
            "state": "active"
          }
        ]
      },
      {
        "title": "Combine inside one peer",
        "narration": "Both namespace team=shop and Pod role=frontend must match, allowing only the shop frontend among these sources.",
        "nodes": [
          {
            "id": "0",
            "label": "Shop frontend",
            "detail": "namespace team=shop; role=frontend",
            "type": "pod",
            "state": "ready"
          },
          {
            "id": "1",
            "label": "Other frontend",
            "detail": "namespace team=other; role=frontend",
            "type": "pod",
            "state": "warning"
          },
          {
            "id": "2",
            "label": "Shop batch",
            "detail": "namespace team=shop; role=batch",
            "type": "pod",
            "state": "warning"
          },
          {
            "id": "3",
            "label": "API policy",
            "detail": "Namespace AND Pod selector",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "API Pod",
            "detail": "TCP 8080",
            "type": "pod",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "0",
            "to": "3",
            "label": "both match",
            "state": "active"
          },
          {
            "from": "1",
            "to": "3",
            "label": "namespace mismatch",
            "state": "blocked"
          },
          {
            "from": "2",
            "to": "3",
            "label": "Pod label mismatch",
            "state": "blocked"
          }
        ]
      },
      {
        "title": "Separate peers broaden access",
        "narration": "If namespaceSelector and podSelector become separate list entries, either peer can match. Shop batch would then match the namespace peer.",
        "nodes": [
          {
            "id": "0",
            "label": "Shop frontend",
            "detail": "namespace team=shop; role=frontend",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Other frontend",
            "detail": "namespace team=other; role=frontend",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "Shop batch",
            "detail": "namespace team=shop; role=batch",
            "type": "pod",
            "state": "warning"
          },
          {
            "id": "3",
            "label": "API policy",
            "detail": "Namespace AND Pod selector",
            "type": "object",
            "state": "warning"
          },
          {
            "id": "4",
            "label": "API Pod",
            "detail": "TCP 8080",
            "type": "pod",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "2",
            "to": "3",
            "label": "namespace peer alone",
            "state": "active"
          }
        ]
      },
      {
        "title": "Prove real enforcement",
        "narration": "Run baseline, denied and allowed requests on the actual cluster. Persisted policy YAML alone proves no data-plane behavior.",
        "nodes": [
          {
            "id": "0",
            "label": "Shop frontend",
            "detail": "namespace team=shop; role=frontend",
            "type": "pod",
            "state": "ready"
