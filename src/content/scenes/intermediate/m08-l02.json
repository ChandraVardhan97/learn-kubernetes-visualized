            "detail": "TCP 8080",
            "type": "pod",
            "state": "ready"
          }
        ],
        "edges": [
          {
            "from": "0",
            "to": "4",
            "label": "positive probe",
            "state": "active"
          },
          {
            "from": "1",
            "to": "4",
            "label": "negative probe",
            "state": "blocked"
          }
        ]
      }
    ],
