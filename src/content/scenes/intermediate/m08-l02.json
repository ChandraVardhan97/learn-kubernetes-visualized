[
  {
    "title": "A connection crosses two independent policy gates",
    "kind": "policy",
    "description": "Trace frontend-to-api traffic through egress and ingress isolation with additive allow rules.",
    "assumption": "An enforcing implementation and ordinary cross-Pod TCP connection; reply traffic is implicit; self and own-node exceptions are outside this path.",
    "frames": [
      {
        "title": "Isolate API ingress",
        "narration": "An ingress policy selects the API. An empty allow set blocks new inbound connections in that direction.",
        "nodes": [
          {
            "id": "0",
            "label": "Frontend",
            "detail": "role=frontend",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Egress gate",
            "detail": "Policies selecting frontend",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "Ingress gate",
            "detail": "Policies selecting api",
            "type": "object",
            "state": "warning"
          },
          {
            "id": "3",
            "label": "API",
            "detail": "app=api; TCP 8080",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Extra allow policy",
            "detail": "Permissions are unioned",
            "type": "object",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "2",
            "to": "3",
            "label": "no ingress allow",
            "state": "blocked"
          }
        ],
        "code": "policyTypes: [Ingress]\ningress: []"
      },
      {
        "title": "Add the required ingress edge",
        "narration": "A second policy can allow frontend TCP 8080. It adds permission even while default-deny remains present.",
        "nodes": [
          {
            "id": "0",
            "label": "Frontend",
            "detail": "role=frontend",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Egress gate",
            "detail": "Policies selecting frontend",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "Ingress gate",
            "detail": "Policies selecting api",
            "type": "object",
            "state": "ready"
          },
          {
            "id": "3",
            "label": "API",
            "detail": "app=api; TCP 8080",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Extra allow policy",
            "detail": "Permissions are unioned",
            "type": "object",
            "state": "active"
          }
        ],
        "edges": [
          {
            "from": "4",
            "to": "2",
            "label": "add allowed edge",
            "state": "active"
          },
          {
            "from": "2",
            "to": "3",
            "label": "TCP 8080",
            "state": "active"
          }
        ]
      },
      {
        "title": "Check source egress too",
        "narration": "If frontend egress is isolated without a matching allow, the connection still fails before reaching the permitted destination.",
        "nodes": [
          {
            "id": "0",
            "label": "Frontend",
            "detail": "role=frontend",
            "type": "pod",
            "state": "active"
          },
          {
            "id": "1",
            "label": "Egress gate",
            "detail": "Policies selecting frontend",
            "type": "object",
            "state": "warning"
          },
          {
            "id": "2",
            "label": "Ingress gate",
            "detail": "Policies selecting api",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "3",
            "label": "API",
            "detail": "app=api; TCP 8080",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Extra allow policy",
            "detail": "Permissions are unioned",
            "type": "object",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "0",
            "to": "1",
            "label": "egress denied",
            "state": "blocked"
          }
        ]
      },
      {
        "title": "Both directions permit",
        "narration": "Once the relevant source egress and destination ingress allow this edge, the connection and its return traffic can pass.",
        "nodes": [
          {
            "id": "0",
            "label": "Frontend",
            "detail": "role=frontend",
            "type": "pod",
            "state": "ready"
          },
          {
            "id": "1",
            "label": "Egress gate",
            "detail": "Policies selecting frontend",
            "type": "object",
            "state": "ready"
          },
          {
            "id": "2",
            "label": "Ingress gate",
            "detail": "Policies selecting api",
            "type": "object",
            "state": "ready"
          },
          {
            "id": "3",
            "label": "API",
            "detail": "app=api; TCP 8080",
            "type": "pod",
            "state": "ready"
          },
          {
            "id": "4",
            "label": "Extra allow policy",
            "detail": "Permissions are unioned",
            "type": "object",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "0",
            "to": "1",
            "label": "allow",
            "state": "active"
          },
          {
            "from": "1",
            "to": "2",
            "label": "TCP 8080",
            "state": "active"
          },
          {
            "from": "2",
            "to": "3",
            "label": "allow",
            "state": "active"
          }
        ]
      }
    ],
    "variants": [
      {
        "id": "failure",
        "label": "An unexpected allow-all exists",
        "description": "An additional policy broadens API ingress because policies do not have deny precedence.",
        "frames": [
          {
            "title": "Default deny is selected",
            "narration": "The direction is isolated and appears restrictive when viewed alone.",
            "nodes": [
              {
                "id": "0",
                "label": "Frontend",
                "detail": "role=frontend",
                "type": "pod",
                "state": "idle"
              },
              {
                "id": "1",
                "label": "Egress gate",
                "detail": "Policies selecting frontend",
                "type": "object",
                "state": "idle"
              },
              {
                "id": "2",
                "label": "Ingress gate",
                "detail": "Policies selecting api",
                "type": "object",
                "state": "warning"
              },
              {
                "id": "3",
                "label": "API",
                "detail": "app=api; TCP 8080",
                "type": "pod",
                "state": "idle"
              },
              {
                "id": "4",
                "label": "Extra allow policy",
                "detail": "Permissions are unioned",
                "type": "object",
                "state": "idle"
              }
            ],
            "edges": []
          },
          {
            "title": "Broad policy adds all peers",
            "narration": "Another selected policy permits all peers. The union now allows those peers despite the default-deny object.",
            "nodes": [
              {
                "id": "0",
                "label": "Frontend",
                "detail": "role=frontend",
                "type": "pod",
                "state": "idle"
              },
              {
                "id": "1",
                "label": "Egress gate",
                "detail": "Policies selecting frontend",
                "type": "object",
                "state": "idle"
              },
              {
                "id": "2",
                "label": "Ingress gate",
                "detail": "Policies selecting api",
                "type": "object",
                "state": "ready"
              },
              {
                "id": "3",
                "label": "API",
                "detail": "app=api; TCP 8080",
                "type": "pod",
                "state": "idle"
              },
              {
                "id": "4",
                "label": "Extra allow policy",
                "detail": "Permissions are unioned",
                "type": "object",
                "state": "warning"
              }
            ],
            "edges": [
              {
                "from": "4",
                "to": "2",
                "label": "union adds all",
                "state": "active"
              }
            ]
          },
          {
            "title": "Audit the full selected set",
            "narration": "Inspect every selected policy rather than ordering objects by creation time; there is no last-rule-wins behavior.",
            "nodes": [
              {
                "id": "0",
                "label": "Frontend",
                "detail": "role=frontend",
                "type": "pod",
                "state": "idle"
              },
              {
                "id": "1",
                "label": "Egress gate",
                "detail": "Policies selecting frontend",
                "type": "object",
                "state": "idle"
              },
              {
                "id": "2",
                "label": "Ingress gate",
                "detail": "Policies selecting api",
                "type": "object",
                "state": "idle"
              },
              {
                "id": "3",
                "label": "API",
                "detail": "app=api; TCP 8080",
                "type": "pod",
                "state": "warning"
              },
              {
                "id": "4",
                "label": "Extra allow policy",
                "detail": "Permissions are unioned",
                "type": "object",
                "state": "idle"
              }
            ],
            "edges": [
              {
                "from": "2",
                "to": "3",
                "label": "broad access",
                "state": "active"
              }
            ],
            "code": "kubectl get networkpolicy -o yaml"
          }
        ]
      }
    ],
    "id": "m08-l02-directions"
