                "state": "idle"
              },
              {
                "id": "3",
                "label": "Root filesystem",
                "detail": "Mounted read-only",
                "type": "storage",
                "state": "idle"
              },
              {
                "id": "4",
                "label": "Work volume",
                "detail": "/work; group-accessible emptyDir",
                "type": "storage",
                "state": "ready"
              }
            ],
            "edges": [
              {
                "from": "0",
