  {
    "title": "Reject an unsafe Pod before node execution",
    "kind": "policy",
    "description": "Trace namespace policy labels through PSA evaluation and distinguish warning from enforcement.",
    "assumption": "Pod Security Admission is enabled with no exemption for the training namespace or identity.",
    "frames": [
      {
        "title": "Select a policy version",
        "narration": "Namespace labels choose the Restricted standard and version for enforcement; the labels themselves require controlled ownership.",
        "nodes": [
          {
            "id": "0",
            "label": "Namespace",
            "detail": "enforce=restricted; version=v1.37",
            "type": "object",
            "state": "active"
          },
          {
            "id": "1",
            "label": "Pod proposal",
            "detail": "privileged: true",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "PSA",
            "detail": "Evaluate configured standard",
            "type": "control",
            "state": "active"
          },
          {
            "id": "3",
            "label": "API storage",
            "detail": "Only admitted Pod is persisted",
            "type": "storage",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Node runtime",
            "detail": "Executes admitted configuration",
            "type": "node",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "0",
            "to": "2",
            "label": "policy selection",
            "state": "active"
          }
        ]
      },
      {
        "title": "Evaluate the proposal",
        "narration": "The privileged container violates Restricted requirements. Authentication and RBAC can succeed before this separate admission rejection.",
        "nodes": [
          {
            "id": "0",
            "label": "Namespace",
            "detail": "enforce=restricted; version=v1.37",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Pod proposal",
            "detail": "privileged: true",
            "type": "object",
            "state": "warning"
          },
          {
            "id": "2",
            "label": "PSA",
            "detail": "Evaluate configured standard",
            "type": "control",
            "state": "active"
          },
          {
            "id": "3",
            "label": "API storage",
            "detail": "Only admitted Pod is persisted",
            "type": "storage",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Node runtime",
            "detail": "Executes admitted configuration",
            "type": "node",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "1",
            "to": "2",
            "label": "validate settings",
            "state": "active"
          }
        ]
      },
      {
        "title": "Reject before persistence",
        "narration": "Enforcement rejects the violating Pod, so this Pod never becomes a node execution request.",
        "nodes": [
          {
            "id": "0",
            "label": "Namespace",
            "detail": "enforce=restricted; version=v1.37",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Pod proposal",
            "detail": "privileged: true",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "PSA",
            "detail": "Evaluate configured standard",
            "type": "control",
            "state": "failed"
          },
          {
            "id": "3",
            "label": "API storage",
            "detail": "Only admitted Pod is persisted",
            "type": "storage",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Node runtime",
            "detail": "Executes admitted configuration",
            "type": "node",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "2",
            "to": "3",
            "label": "admission denied",
            "state": "blocked"
          }
        ]
      },
      {
        "title": "Admit a compliant configuration",
        "narration": "After using compliant fields, a new proposal can persist and reach the node. Runtime permissions still need actual testing.",
        "nodes": [
          {
            "id": "0",
            "label": "Namespace",
            "detail": "enforce=restricted; version=v1.37",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Pod proposal",
            "detail": "Compliant non-root configuration; privileged unset/false",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "PSA",
            "detail": "Evaluate configured standard",
            "type": "control",
            "state": "idle"
          },
          {
            "id": "3",
            "label": "API storage",
            "detail": "Only admitted Pod is persisted",
            "type": "storage",
            "state": "ready"
          },
          {
            "id": "4",
            "label": "Node runtime",
            "detail": "Executes admitted configuration",
            "type": "node",
            "state": "active"
          }
        ],
        "edges": [
          {
            "from": "2",
            "to": "3",
            "label": "compliant Pod",
            "state": "active"
          },
          {
            "from": "3",
            "to": "4",
            "label": "schedule + start",
            "state": "active"
          }
        ]
      }
    ],
