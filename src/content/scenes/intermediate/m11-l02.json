            "title": "Write fails at runtime",
            "narration": "Writing outside /work fails because that path belongs to the read-only root filesystem.",
            "nodes": [
              {
                "id": "0",
                "label": "Container process",
                "detail": "UID/GID 1000; non-root",
                "type": "actor",
                "state": "warning"
