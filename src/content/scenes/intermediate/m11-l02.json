              },
              {
                "id": "4",
                "label": "Work volume",
                "detail": "/work; group-accessible emptyDir",
                "type": "storage",
                "state": "idle"
              }
            ],
            "edges": [
              {
                "from": "0",
                "to": "3",
                "label": "read-only filesystem",
                "state": "blocked"
              }
            ]
          },
          {
            "title": "Fix application paths",
            "narration": "Configure temporary and state paths or add a narrowly scoped writable mount; do not enable privileged mode to bypass a filesystem design mistake.",
            "nodes": [
              {
                "id": "0",
                "label": "Container process",
                "detail": "UID/GID 1000; non-root",
                "type": "actor",
                "state": "idle"
              },
              {
                "id": "1",
