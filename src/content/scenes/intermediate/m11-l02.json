[
  {
    "title": "Constrain the process without hiding its required writes",
    "kind": "policy",
    "description": "Connect UID, capability, seccomp and filesystem choices to a non-root writable-path example.",
    "assumption": "Linux node with RuntimeDefault seccomp and an emptyDir volume; not a complete hostile-code sandbox.",
    "frames": [
      {
        "title": "Choose process identity",
        "narration": "The process runs as UID 1000. runAsNonRoot checks that it is not configured to execute as root.",
        "nodes": [
          {
            "id": "0",
            "label": "Container process",
            "detail": "UID/GID 1000; non-root",
            "type": "actor",
            "state": "active"
          },
          {
            "id": "1",
            "label": "Kernel privileges",
            "detail": "drop ALL; no privilege escalation",
            "type": "node",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "Seccomp profile",
            "detail": "RuntimeDefault syscall filter",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "3",
            "label": "Root filesystem",
            "detail": "Mounted read-only",
            "type": "storage",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Work volume",
            "detail": "/work; group-accessible emptyDir",
            "type": "storage",
            "state": "idle"
          }
        ],
        "edges": [],
        "code": "runAsNonRoot: true\nrunAsUser: 1000"
      },
      {
        "title": "Reduce kernel powers",
        "narration": "Dropping capabilities and disabling privilege escalation reduce privilege paths independently of the UID choice.",
        "nodes": [
          {
            "id": "0",
            "label": "Container process",
            "detail": "UID/GID 1000; non-root",
            "type": "actor",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Kernel privileges",
            "detail": "drop ALL; no privilege escalation",
            "type": "node",
            "state": "ready"
          },
          {
            "id": "2",
            "label": "Seccomp profile",
            "detail": "RuntimeDefault syscall filter",
            "type": "object",
            "state": "ready"
          },
          {
            "id": "3",
            "label": "Root filesystem",
            "detail": "Mounted read-only",
            "type": "storage",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Work volume",
            "detail": "/work; group-accessible emptyDir",
            "type": "storage",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "0",
            "to": "1",
            "label": "restricted powers",
            "state": "active"
          },
          {
            "from": "0",
            "to": "2",
            "label": "filtered syscalls",
            "state": "active"
          }
        ]
      },
      {
        "title": "Protect the image filesystem",
        "narration": "The root filesystem is read-only, so an application writing there should receive an error rather than mutate its executable environment.",
        "nodes": [
          {
            "id": "0",
            "label": "Container process",
            "detail": "UID/GID 1000; non-root",
            "type": "actor",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Kernel privileges",
            "detail": "drop ALL; no privilege escalation",
            "type": "node",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "Seccomp profile",
            "detail": "RuntimeDefault syscall filter",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "3",
            "label": "Root filesystem",
            "detail": "Mounted read-only",
            "type": "storage",
            "state": "ready"
          },
          {
            "id": "4",
            "label": "Work volume",
            "detail": "/work; group-accessible emptyDir",
            "type": "storage",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "0",
            "to": "3",
            "label": "write rejected",
            "state": "blocked"
          }
        ],
        "code": "readOnlyRootFilesystem: true"
      },
      {
        "title": "Allow a deliberate writable path",
        "narration": "A separately mounted emptyDir provides /work with suitable group permissions; read-only root does not override this mount.",
        "nodes": [
          {
            "id": "0",
            "label": "Container process",
            "detail": "UID/GID 1000; non-root",
            "type": "actor",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Kernel privileges",
            "detail": "drop ALL; no privilege escalation",
            "type": "node",
            "state": "idle"
          },
          {
