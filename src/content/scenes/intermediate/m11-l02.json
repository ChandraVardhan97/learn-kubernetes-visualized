            "type": "storage",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Work volume",
            "detail": "/work; group-accessible emptyDir",
            "type": "storage",
            "state": "ready"
          }
        ],
        "edges": [
          {
            "from": "0",
            "to": "4",
            "label": "write /work/status",
            "state": "active"
          }
        ]
      }
    ],
    "variants": [
      {
        "id": "failure",
        "label": "Application writes to the wrong path",
        "description": "The process tries to write to its read-only root filesystem.",
        "frames": [
          {
            "title": "Pod is admitted",
