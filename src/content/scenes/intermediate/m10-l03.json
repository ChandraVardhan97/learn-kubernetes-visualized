          {
            "id": "2",
            "label": "kubelet",
            "detail": "Grace-period deadline",
            "type": "node",
            "state": "active"
          },
          {
            "id": "3",
            "label": "preStop hook",
            "detail": "Runs within grace budget",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Application process",
            "detail": "Handle stop signal and exit",
            "type": "actor",
            "state": "idle"
          },
          {
            "id": "5",
            "label": "Clients / proxy",
            "detail": "Observe endpoint updates",
            "type": "service",
            "state": "idle"
