  {
    "title": "Traffic removal and process shutdown share a deadline",
    "kind": "lifecycle",
    "description": "Trace deletion, endpoint readiness, preStop, stop signal and final process exit.",
    "assumption": "One ordinary container and a normal deletion; precise propagation time depends on components.",
    "frames": [
      {
        "title": "Deletion begins",
        "narration": "The API records deletion and a grace period. Endpoint state and node shutdown react asynchronously to that transition.",
        "nodes": [
          {
            "id": "0",
            "label": "API Pod",
            "detail": "Handles active requests",
            "type": "pod",
            "state": "warning"
          },
          {
            "id": "1",
            "label": "EndpointSlice",
            "detail": "Terminating / not ready",
            "type": "object",
            "state": "active"
