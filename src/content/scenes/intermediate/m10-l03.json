  {
    "title": "Eviction asks permission from the current health budget",
    "kind": "policy",
    "description": "Follow cordon, PDB health evaluation, eviction and replacement during maintenance.",
    "assumption": "Three selected replicas with minAvailable=2; ordinary Eviction API path and a controller-managed workload.",
    "frames": [
      {
        "title": "Cordon the worker",
        "narration": "The node becomes unschedulable for ordinary new Pods. Existing workloads do not move merely because it is cordoned.",
        "nodes": [
          {
            "id": "0",
            "label": "Worker A",
            "detail": "Node to maintain",
            "type": "node",
            "state": "warning"
          },
