  {
    "title": "Roles describe actions; bindings grant them",
    "kind": "policy",
    "description": "Follow namespaced RBAC evaluation and show why a second allow remains effective.",
    "assumption": "RBAC is the relevant authorizer in this example; subjects may receive several grants.",
    "frames": [
      {
        "title": "Describe the allowed actions",
        "narration": "The Role grants explicit verbs on core Pods. Pod deletion, logs and exec are not implied by read access to the Pod resource.",
        "nodes": [
          {
            "id": "0",
            "label": "Identity",
            "detail": "learning:pod-reader",
            "type": "actor",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Role read-pod-state",
            "detail": "get/list/watch core pods",
            "type": "object",
            "state": "active"
          },
          {
            "id": "2",
            "label": "RoleBinding",
            "detail": "Identity → Role in learning",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "3",
            "label": "API authorization",
            "detail": "Evaluate verb/resource/namespace",
            "type": "control",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Other binding",
            "detail": "May add wider permission",
            "type": "object",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "1",
            "to": "3",
            "label": "rules",
            "state": "active"
          }
        ]
      },
      {
        "title": "Grant to a subject",
        "narration": "The namespaced RoleBinding connects this ServiceAccount to those Role rules in learning.",
        "nodes": [
