            "id": "0",
            "label": "Identity",
            "detail": "learning:pod-reader",
            "type": "actor",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Role read-pod-state",
            "detail": "get/list/watch core pods",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "RoleBinding",
            "detail": "Identity → Role in learning",
            "type": "object",
            "state": "active"
          },
          {
            "id": "3",
            "label": "API authorization",
            "detail": "Evaluate verb/resource/namespace",
            "type": "control",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Other binding",
            "detail": "May add wider permission",
            "type": "object",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "0",
            "to": "2",
            "label": "subject",
            "state": "active"
          },
          {
            "from": "2",
            "to": "1",
            "label": "roleRef",
            "state": "active"
          }
        ]
      },
      {
        "title": "Evaluate the concrete request",
        "narration": "list pods in learning is allowed through the binding; delete pods is not supplied by this role.",
        "nodes": [
          {
            "id": "0",
            "label": "Identity",
            "detail": "learning:pod-reader",
            "type": "actor",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Role read-pod-state",
            "detail": "get/list/watch core pods",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "RoleBinding",
            "detail": "Identity → Role in learning",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "3",
            "label": "API authorization",
            "detail": "Evaluate verb/resource/namespace",
            "type": "control",
            "state": "ready"
          },
          {
            "id": "4",
            "label": "Other binding",
            "detail": "May add wider permission",
            "type": "object",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "0",
            "to": "3",
            "label": "list pods / learning",
            "state": "active"
          }
        ],
        "code": "kubectl auth can-i list pods -n learning --as=system:serviceaccount:learning:pod-reader"
      },
      {
        "title": "Union all applicable grants",
        "narration": "Another binding can grant delete or cluster-wide access. The narrow role does not subtract those permissions.",
        "nodes": [
          {
            "id": "0",
            "label": "Identity",
            "detail": "learning:pod-reader",
