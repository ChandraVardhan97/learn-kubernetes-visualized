  {
    "title": "Classify configuration before diagnosing pressure",
    "kind": "policy",
    "description": "Compare Guaranteed, Burstable and BestEffort configuration and their relationship to node pressure.",
    "assumption": "Uses ordinary per-container CPU and memory fields; QoS is not a complete eviction algorithm.",
    "frames": [
      {
        "title": "Guaranteed is configuration",
        "narration": "Both resource pairs must be present and equal for every container in this simplified configuration.",
        "nodes": [
          {
            "id": "0",
            "label": "Guaranteed Pod",
            "detail": "Every CPU/memory request equals its limit",
            "type": "pod",
            "state": "ready"
          },
          {
            "id": "1",
            "label": "Burstable Pod",
            "detail": "CPU/memory request or limit set; Guaranteed rule fails",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "BestEffort Pod",
            "detail": "No CPU/memory requests or limits",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "3",
            "label": "Node pressure",
            "detail": "Priority and usage relative to requests matter",
            "type": "node",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Own memory limit",
            "detail": "Can still kill a Guaranteed container",
