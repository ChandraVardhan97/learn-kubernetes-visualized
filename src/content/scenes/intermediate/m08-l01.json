            "id": "4",
            "label": "Pod ready",
            "detail": "app=api; port 8080",
            "type": "pod",
            "state": "ready"
          },
          {
            "id": "5",
            "label": "Pod unready",
            "detail": "app=api; readiness false",
            "type": "pod",
            "state": "warning"
          }
        ],
        "edges": [
