            "label": "CNI implementation",
            "detail": "IP allocation, interfaces, routes",
            "type": "control",
            "state": "active"
          },
          {
            "id": "3",
            "label": "Worker B",
            "detail": "Underlay or overlay path",
            "type": "node",
            "state": "idle"
