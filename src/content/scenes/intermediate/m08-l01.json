  {
    "title": "A virtual IP forwards only to usable backends",
    "kind": "flow",
    "description": "Trace controller-produced EndpointSlices and Service data-plane programming through a readiness change.",
    "assumption": "Ordinary selector Service without publishNotReadyAddresses; all-unready variant is non-terminating; existing connections are not modeled.",
    "frames": [
      {
        "title": "Select matching Pods",
        "narration": "The controller observes Pods matching app=api and publishes backend addresses and conditions in EndpointSlices.",
        "nodes": [
          {
            "id": "0",
            "label": "Client",
            "detail": "Connect to api:80",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Service api",
            "detail": "ClusterIP; targetPort 8080",
            "type": "service",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "EndpointSlice",
            "detail": "Pod addresses + readiness",
            "type": "object",
            "state": "active"
          },
          {
            "id": "3",
            "label": "Node data plane",
            "detail": "kube-proxy or provider replacement",
            "type": "node",
            "state": "idle"
          },
          {
            "id": "4",
            "label": "Pod ready",
            "detail": "app=api; port 8080",
            "type": "pod",
            "state": "ready"
          },
          {
            "id": "5",
            "label": "Pod unready",
            "detail": "app=api; readiness false",
            "type": "pod",
            "state": "warning"
