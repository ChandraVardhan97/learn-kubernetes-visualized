  {
    "title": "Build a cross-node Pod path",
    "kind": "flow",
    "description": "Follow sandbox network setup and a packet between Pods on different workers.",
    "assumption": "CNI providers implement this contract differently; arrows do not prescribe an overlay or particular kernel hook.",
    "frames": [
      {
        "title": "Prepare the network namespace",
        "narration": "Before application traffic, the runtime arranges the Pod sandbox and asks the configured network integration to connect it.",
