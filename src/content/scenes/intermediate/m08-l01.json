    ],
    "variants": [
      {
        "id": "failure",
        "label": "Cross-node path broken",
        "description": "The application listens, but the route between workers is missing or blocked.",
        "frames": [
          {
            "title": "Local listener is healthy",
            "narration": "Pod B can answer on its own network interface, so the application is not the first failing boundary.",
            "nodes": [
              {
                "id": "0",
