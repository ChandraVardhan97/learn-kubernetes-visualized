        "edges": [
          {
            "from": "4",
            "to": "2",
            "label": "ready=true",
            "state": "active"
          },
          {
            "from": "5",
            "to": "2",
            "label": "ready=false",
            "state": "active"
          }
        ]
      },
      {
        "title": "Program the forwarding path",
        "narration": "The node implementation watches Service and endpoint state. Kube-proxy can program kernel rules such as iptables or nftables; a provider replacement can program eBPF hooks and backend maps. Neither requires a central userspace Service relay for every packet.",
        "nodes": [
          {
            "id": "0",
            "label": "Client",
            "detail": "Connect to api:80",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "1",
            "label": "Service api",
            "detail": "ClusterIP; targetPort 8080",
            "type": "service",
            "state": "idle"
          },
          {
            "id": "2",
            "label": "EndpointSlice",
            "detail": "Pod addresses + readiness",
            "type": "object",
            "state": "idle"
          },
          {
            "id": "3",
            "label": "Node data plane",
            "detail": "kube-proxy or provider replacement",
            "type": "node",
            "state": "active"
          },
          {
            "id": "4",
            "label": "Pod ready",
            "detail": "app=api; port 8080",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "5",
            "label": "Pod unready",
            "detail": "app=api; readiness false",
            "type": "pod",
            "state": "idle"
          }
        ],
        "edges": [
          {
            "from": "1",
            "to": "3",
            "label": "virtual IP + port",
            "state": "active"
          },
          {
            "from": "2",
            "to": "3",
            "label": "usable endpoints",
            "state": "active"
          }
        ]
