  {
    "title": "Carry context across calls, then correlate signals",
    "kind": "flow",
    "description": "Trace parent/child spans, structured log correlation and Collector processing with redaction.",
    "assumption": "Instrumented services propagate compatible context; traces can be sampled.",
    "frames": [
      {
        "title": "Start a request trace",
        "narration": "Instrumentation creates a span with a service identity and operation. Useful attributes describe the operation without copying sensitive payloads.",
        "nodes": [
          {
            "id": "0",
            "label": "Client request",
            "detail": "Starts trace context",
            "type": "actor",
            "state": "idle"
