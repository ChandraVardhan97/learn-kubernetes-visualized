            "id": "1",
            "label": "API span",
            "detail": "Service name + operation",
            "type": "pod",
            "state": "active"
          },
          {
            "id": "2",
            "label": "Worker span",
            "detail": "Child context across call",
            "type": "pod",
            "state": "idle"
          },
          {
            "id": "3",
            "label": "Structured log",
            "detail": "Trace ID + useful event",
            "type": "object",
            "state": "idle"
          },
