  {
    "title": "A Lease does not reject stale external writes",
    "kind": "flow",
    "description": "A target that validates a monotonic fencing epoch can reject stale writes; idempotency addresses a different duplicate-work boundary.",
    "assumption": "The external system must implement the protection; client-go leader election alone offers no fencing guarantee.",
    "frames": [
      {
        "title": "External work begins",
        "narration": "A sends a request while leading; the request may remain in flight after A pauses.",
        "nodes": [
          {
            "id": "old",
            "label": "Old leader A",
            "type": "control",
            "detail": "Delayed external request",
            "x": 35,
            "y": 45,
            "state": "active"
          },
          {
            "id": "new",
            "label": "New leader B",
            "type": "control",
            "detail": "B has yet to take over",
            "x": 290,
            "y": 45,
            "state": "idle"
          },
          {
            "id": "lease",
            "label": "Lease",
            "type": "object",
            "detail": "Still held by A",
            "x": 545,
            "y": 45,
            "state": "idle"
          },
          {
            "id": "target",
            "label": "External system",
            "type": "storage",
            "detail": "Must enforce fencing if required",
            "x": 35,
            "y": 230,
