[
  {
    "title": "List, resume, and rebuild a watch",
    "kind": "flow",
    "description": "A worker reads the cache and compares current observations with desired state. Cache visibility can lag an API write.",
    "assumption": "A traditional list-then-watch client is shown; optional streaming-list optimizations are omitted. Documented same-resource version ordering does not make the cursor a clock or event count.",
    "frames": [
      {
        "title": "Establish the baseline",
        "narration": "A list supplies collection state and a resourceVersion cursor. Preserve the string unchanged and follow the documented same-resource ordering contract.",
        "nodes": [
          {
            "id": "api",
            "label": "API server",
            "type": "control",
            "detail": "Collection and watch history",
            "x": 35,
            "y": 45,
            "state": "idle"
          },
          {
            "id": "list",
            "label": "List baseline",
            "type": "object",
            "detail": "Objects + resumable cursor",
            "x": 290,
            "y": 45,
            "state": "active"
          },
          {
            "id": "watch",
            "label": "Watch stream",
            "type": "control",
            "detail": "Changes after cursor",
            "x": 545,
            "y": 45,
            "state": "idle"
          },
          {
            "id": "cache",
            "label": "Client cache",
            "type": "storage",
            "detail": "Eventually updated local state",
            "x": 35,
            "y": 230,
            "state": "idle"
          }
        ],
        "edges": [
          {
            "to": "list",
