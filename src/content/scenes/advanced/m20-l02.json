  {
    "title": "Restore bytes, then prove a new Pod sees them",
    "kind": "lifecycle",
    "description": "A new Pod UID mounts the same PVC and reads the restored content, demonstrating persistence after recovery.",
    "assumption": "The actual lab has one completed CSV write and tests file restoration, not database recovery or node-loss resilience.",
    "frames": [
      {
        "title": "Restore the record",
        "narration": "kubectl cp restores /data/orders.csv in the existing volume; byte counts and SHA-256 digests must match the private host backup.",
        "nodes": [
          {
            "id": "backup",
            "label": "Host CSV backup",
            "type": "storage",
            "detail": "Retained original record",
            "x": 35,
            "y": 45,
            "state": "idle"
          },
          {
            "id": "restore",
            "label": "Restore file copy",
            "type": "actor",
            "detail": "kubectl cp; tar in image",
            "x": 290,
            "y": 45,
            "state": "active"
          },
          {
            "id": "pvc",
            "label": "Existing PVC",
            "type": "storage",
            "detail": "Same bound storage",
            "x": 545,
            "y": 45,
            "state": "idle"
          },
          {
            "id": "newpod",
            "label": "Replacement Pod",
            "type": "pod",
            "detail": "New UID, same claim",
            "x": 35,
            "y": 230,
            "state": "idle"
          },
          {
            "id": "verify",
            "label": "Content assertion",
            "type": "object",
            "detail": "order-42,confirmed",
            "x": 290,
            "y": 230,
            "state": "idle"
