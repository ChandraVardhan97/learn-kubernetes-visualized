  {
    "title": "API registration precedes reconciliation",
    "kind": "flow",
    "description": "The Python operator reads the instance and applies ordinary Kubernetes children.",
    "assumption": "The concrete lab uses a single namespaced v1alpha1 API and a host-run polling controller.",
