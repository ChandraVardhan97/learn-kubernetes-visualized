          {
            "id": "crd",
            "label": "WebApp CRD",
            "type": "object",
            "detail": "Schema + resource registration",
            "x": 35,
            "y": 45,
            "state": "active"
          },
          {
            "id": "api",
            "label": "API server",
            "type": "control",
            "detail": "Validate and store instance",
            "x": 290,
            "y": 45,
            "state": "idle"
          },
          {
            "id": "cr",
            "label": "WebApp instance",
            "type": "object",
            "detail": "spec.replicas + message",
            "x": 545,
            "y": 45,
            "state": "idle"
          },
          {
            "id": "operator",
            "label": "Python operator",
            "type": "control",
            "detail": "Separate reconcile process",
            "x": 35,
            "y": 230,
            "state": "idle"
