  {
    "title": "Representation, storage, and observed generation",
    "kind": "flow",
    "description": "The controller writes status through its subresource. observedGeneration can advance before readyReplicas reaches the target.",
    "assumption": "The lab has one version and no conversion webhook; the failure branch models a future multi-version API.",
    "frames": [
      {
        "title": "Serve a version",
        "narration": "The client uses a served representation whose schema defines fields and validation.",
        "nodes": [
          {
            "id": "client",
            "label": "Versioned client",
            "type": "actor",
            "detail": "Requests a served API",
            "x": 35,
            "y": 45,
            "state": "active"
          },
          {
            "id": "convert",
            "label": "Schema / conversion",
            "type": "control",
            "detail": "Representation boundary",
