  {
    "title": "Repeat, repair, then collect owned children",
    "kind": "lifecycle",
    "description": "Removing the WebApp lets garbage collection remove its owned children; the operator does not recreate the absent parent.",
    "assumption": "The teaching controller manages only Kubernetes resources and supplies no external cleanup finalizer or production HA machinery.",
