                "y": 230,
                "state": "failed"
              },
              {
                "id": "pods",
                "label": "nginx Pods",
                "type": "pod",
                "detail": "Normal Deployment rollout",
                "x": 290,
                "y": 230,
                "state": "idle"
              }
            ],
            "edges": [
              {
                "to": "dep",
                "label": "apply failed",
                "state": "blocked",
                "from": "op"
              }
            ]
          },
          {
            "title": "Next pass resumes",
            "narration": "Fix the cause and rerun reconciliation; the existing correctly owned ConfigMap is reused.",
