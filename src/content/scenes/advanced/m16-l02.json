[
  {
    "title": "WebApp intent becomes ordinary resources",
    "kind": "flow",
    "description": "Deployment controllers and kubelets create ready Pods; the custom controller does not synchronously start containers.",
    "assumption": "The downloadable controller polls through kubectl and intentionally omits production informer and queue machinery.",
    "frames": [
      {
        "title": "Derive desired children",
        "narration": "The operator maps one WebApp to stable ConfigMap and Deployment names.",
        "nodes": [
          {
            "id": "cr",
            "label": "WebApp m16",
            "type": "object",
            "detail": "replicas + page message",
            "x": 35,
            "y": 45,
            "state": "idle"
          },
          {
            "id": "op",
            "label": "Python reconcile",
            "type": "control",
            "detail": "Compute desired children",
            "x": 290,
            "y": 45,
            "state": "active"
          },
          {
            "id": "cm",
            "label": "ConfigMap m16",
            "type": "object",
            "detail": "index.html from message",
            "x": 545,
            "y": 45,
            "state": "idle"
          },
          {
            "id": "dep",
            "label": "Deployment m16",
            "type": "object",
            "detail": "replicas from spec",
            "x": 35,
            "y": 230,
            "state": "idle"
          },
          {
            "id": "pods",
            "label": "nginx Pods",
            "type": "pod",
            "detail": "Normal Deployment rollout",
            "x": 290,
            "y": 230,
            "state": "idle"
          }
