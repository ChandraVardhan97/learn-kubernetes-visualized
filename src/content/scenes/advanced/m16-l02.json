  {
    "title": "Identity is stable while observation advances",
    "kind": "lifecycle",
    "description": "Status records the desired generation processed and the ready count actually observed, which may still be zero.",
    "assumption": "The minimal API lacks a Ready condition; sampled readyReplicas may reflect an earlier Deployment generation and does not prove current-revision readiness.",
    "frames": [
      {
        "title": "Repeat the same intention",
        "narration": "Another pass applies the same child name and ownership instead of creating a replacement Deployment.",
        "nodes": [
          {
            "id": "intent",
            "label": "WebApp generation",
            "type": "object",
            "detail": "Desired generation G",
            "x": 35,
            "y": 45,
            "state": "idle"
          },
          {
            "id": "dep",
            "label": "Deployment UID D",
            "type": "object",
            "detail": "Stable generated child",
            "x": 290,
            "y": 45,
            "state": "active"
          },
          {
            "id": "op",
            "label": "Reconcile pass",
            "type": "control",
            "detail": "Read current Deployment status",
            "x": 545,
            "y": 45,
            "state": "idle"
          },
          {
            "id": "status",
            "label": "WebApp status",
            "type": "object",
