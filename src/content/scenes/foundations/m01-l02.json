[
  {
    "id": "m01-l02-image-layers",
    "title": "Image identity and writable changes",
    "kind": "storage",
    "description": "Separate image layers, a tag reference, and a container writable layer.",
    "assumption": "A single-platform image is shown; registries can instead return a multi-platform index.",
    "frames": [
      {
        "title": "Publish layered content",
        "narration": "The image manifest describes immutable layer content and configuration. A repository tag points to a manifest identity.",
        "nodes": [
          {
            "id": "tag",
            "label": "web:training",
            "type": "object",
            "state": "active",
            "detail": ""
          },
          {
            "id": "manifest",
            "label": "Manifest digest",
            "type": "object",
            "state": "ready",
            "detail": ""
          },
          {
            "id": "layers",
            "label": "Read-only layers",
            "type": "storage",
            "state": "ready",
            "detail": ""
          }
        ],
        "edges": [
          {
            "to": "manifest",
            "label": "resolves to",
            "state": "active",
            "from": "tag"
          },
          {
            "to": "layers",
            "label": "references hashes",
            "state": "active",
            "from": "manifest"
          }
        ]
      },
      {
        "title": "Create a container",
        "narration": "The runtime assembles the image filesystem and adds a writable layer for this container instance.",
        "nodes": [
          {
            "id": "layers",
            "label": "Read-only layers",
            "type": "storage",
            "state": "ready",
            "detail": ""
          },
          {
            "id": "write",
            "label": "Container writable layer",
            "type": "storage",
            "state": "active",
            "detail": ""
          },
          {
            "id": "process",
            "label": "Web executable",
            "type": "actor",
            "state": "active",
            "detail": ""
          }
        ],
        "edges": [
          {
            "to": "process",
            "label": "starting files",
            "state": "active",
            "from": "layers"
          },
          {
            "to": "write",
            "label": "runtime writes",
            "state": "active",
            "from": "process"
          }
        ]
      },
      {
        "title": "Move a tag, preserve identity",
        "narration": "A tag may point somewhere new. A recorded digest still identifies the original content; the existing process does not silently switch.",
        "nodes": [
          {
            "id": "tag",
            "label": "Tag now points to B",
            "type": "object",
            "state": "warning",
            "detail": ""
          },
          {
            "id": "old",
            "label": "Digest A",
            "type": "object",
            "state": "ready",
