                "to": "new",
                "label": "fresh starting state",
                "state": "active",
                "from": "layers"
              }
            ]
          },
          {
            "title": "Choose the right state lifetime",
            "narration": "Use an explicit volume for state that must follow a Pod or outlive it. Rebuilding an image and mounting storage solve different problems.",
            "nodes": [
              {
                "id": "process",
                "label": "Application",
                "type": "actor",
                "state": "ready",
                "detail": ""
              },
              {
                "id": "volume",
                "label": "Explicit volume",
                "type": "storage",
                "state": "ready",
                "detail": ""
              }
            ],
            "edges": [
              {
                "to": "volume",
                "label": "state written to mount",
                "state": "active",
                "from": "process"
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "m01-l02-registry-pull",
    "title": "The node pulls the image",
    "kind": "flow",
    "description": "Follow a kubelet/runtime image request through registry resolution and cache reuse.",
    "assumption": "Registry access is from the worker runtime; one node and one image are shown.",
    "frames": [
      {
        "title": "Pod names an image",
        "narration": "The assigned Pod asks for nginx:1.27.5. The kubelet delegates image work through the container runtime interface.",
        "nodes": [
          {
            "id": "pod",
            "label": "Pod image reference",
            "type": "pod",
            "state": "active",
            "detail": ""
          },
          {
            "id": "kubelet",
            "label": "Kubelet",
            "type": "control",
            "state": "active",
            "detail": ""
          },
          {
            "id": "runtime",
            "label": "Container runtime",
            "type": "control",
            "state": "idle",
            "detail": ""
          }
        ],
        "edges": [
          {
            "to": "kubelet",
            "label": "assigned specification",
            "state": "active",
            "from": "pod"
          },
          {
            "to": "runtime",
            "label": "ensure image",
            "state": "active",
            "from": "kubelet"
          }
        ]
      },
      {
        "title": "Resolve and reuse content",
        "narration": "When a pull is required, the runtime resolves the manifest and downloads only missing layers. Cached content can still be reused with Always.",
        "nodes": [
          {
            "id": "runtime",
            "label": "Runtime + cache",
            "type": "control",
            "state": "active",
            "detail": ""
          },
          {
            "id": "registry",
            "label": "Image registry",
            "type": "storage",
            "state": "active",
            "detail": ""
          },
          {
            "id": "layers",
            "label": "Verified layer content",
            "type": "storage",
            "state": "ready",
            "detail": ""
          }
        ],
        "edges": [
          {
            "to": "registry",
            "label": "resolve / authenticate",
            "state": "active",
            "from": "runtime"
          },
          {
            "to": "layers",
            "label": "missing content",
            "state": "active",
            "from": "registry"
          },
          {
            "to": "runtime",
            "label": "local cache",
            "state": "active",
            "from": "layers"
          }
        ]
      },
      {
        "title": "Start the executable",
        "narration": "After image preparation and sandbox setup, the runtime creates the container. The required image must be available, either from a permitted local cache or a pull; that does not establish application health.",
        "nodes": [
          {
            "id": "runtime",
            "label": "Container runtime",
            "type": "control",
            "state": "ready",
            "detail": ""
          },
          {
            "id": "web",
            "label": "nginx process",
            "type": "pod",
            "state": "active",
            "detail": ""
          },
          {
            "id": "kubelet",
            "label": "Kubelet reports status",
            "type": "control",
            "state": "active",
            "detail": ""
          }
        ],
        "edges": [
          {
            "to": "web",
            "label": "start",
            "state": "active",
            "from": "runtime"
          },
          {
            "to": "kubelet",
            "label": "container status",
            "state": "active",
            "from": "runtime"
          }
        ]
      }
    ],
    "variants": [
      {
