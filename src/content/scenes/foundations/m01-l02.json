                "id": "layers",
                "label": "Image layers",
                "type": "storage",
                "state": "ready",
                "detail": ""
              }
            ],
            "edges": [
              {
                "to": "write",
                "label": "write",
                "state": "active",
                "from": "process"
              }
            ]
          },
          {
            "title": "Replace the container",
            "narration": "A replacement starts from the same image but receives a fresh writable layer. The old runtime file is absent.",
            "nodes": [
              {
                "id": "old",
