          },
          {
            "id": "new",
            "label": "Digest B",
            "type": "object",
            "state": "active",
            "detail": ""
          },
          {
            "id": "process",
            "label": "Running digest A",
            "type": "actor",
            "state": "ready",
            "detail": ""
          }
        ],
        "edges": [
          {
            "to": "new",
            "label": "new resolution",
            "state": "active",
            "from": "tag"
          },
          {
            "to": "process",
            "label": "original content",
            "state": "active",
            "from": "old"
          }
        ]
      }
    ],
    "variants": [
      {
        "id": "m01-l02-image-layers-failure",
        "label": "Failure: runtime writes are mistaken for image changes",
        "description": "Failure: runtime writes are mistaken for image changes",
        "frames": [
          {
            "title": "Write application state",
            "narration": "The process writes a file into its container filesystem, above the immutable image layers.",
            "nodes": [
              {
                "id": "process",
                "label": "Application",
                "type": "actor",
                "state": "active",
                "detail": ""
              },
