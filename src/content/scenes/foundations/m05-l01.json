[
  {
    "id": "m05-l01-ownership",
    "title": "A Deployment owns a release hierarchy",
    "kind": "ownership",
    "description": "Show the actual controller and resource ownership boundaries.",
    "assumption": "One active ReplicaSet is shown; later lessons add an old revision during rollout.",
    "frames": [
      {
        "title": "Declare the parent",
        "narration": "The Deployment declares replicas and a Pod template. Its controller creates or reuses the ReplicaSet representing that template.",
        "nodes": [
          {
            "id": "deploy",
            "label": "Deployment replicas: 3",
            "type": "object",
            "state": "active",
            "detail": "",
            "x": 34,
            "y": 28
          },
          {
            "id": "dc",
            "label": "Deployment controller",
            "type": "control",
            "state": "active",
            "detail": "",
            "x": 560,
            "y": 28
          },
          {
            "id": "rs",
            "label": "ReplicaSet target: 3",
            "type": "object",
            "state": "ready",
            "detail": "",
            "x": 297,
            "y": 28
          }
        ],
        "edges": [
          {
            "to": "rs",
            "label": "create / set target",
            "state": "active",
            "from": "dc"
          },
          {
            "to": "rs",
            "label": "owns",
            "state": "active",
            "from": "deploy"
          }
        ]
      },
      {
        "title": "The ReplicaSet creates Pods",
        "narration": "The ReplicaSet controller observes its target and creates three Pod objects. It is the immediate controller responsible for this count.",
