                "detail": "",
                "x": 34,
                "y": 28
              },
              {
                "id": "rs",
                "label": "Managed target",
                "type": "object",
                "state": "ready",
                "detail": "",
                "x": 297,
                "y": 28
              }
            ],
            "edges": [
