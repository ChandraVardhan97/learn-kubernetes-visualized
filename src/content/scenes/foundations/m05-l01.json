              {
                "id": "rs",
                "label": "Target returns to 3",
                "type": "object",
                "state": "active",
                "detail": "",
                "x": 297,
                "y": 28
              }
            ],
            "edges": [
              {
                "to": "rs",
                "label": "reconcile parent plan",
                "state": "active",
                "from": "dc"
              }
            ]
          },
          {
            "title": "Change the owning workload",
            "narration": "Edit the Deployment and source manifest deliberately. Inspect children for evidence without treating them as independent release controls.",
