            "state": "active",
            "from": "rs"
          },
          {
            "from": "rs",
            "to": "b",
            "label": "owns",
            "state": "active"
          },
          {
            "from": "rs",
            "to": "c",
            "label": "owns",
            "state": "active"
          }
        ]
      },
      {
        "title": "Other components place and execute",
        "narration": "The scheduler binds new Pods; node kubelets use runtimes to start them. Neither task is performed by the replica counter.",
        "nodes": [
          {
            "id": "sched",
            "label": "Scheduler",
            "type": "control",
            "state": "active",
            "detail": ""
          },
          {
            "id": "node",
