            "state": "active",
            "detail": "",
            "x": 297,
            "y": 28
          },
          {
            "id": "rc",
            "label": "ReplicaSet controller",
            "type": "control",
            "state": "active",
            "detail": "",
            "x": 34,
            "y": 28
          },
          {
            "id": "a",
            "label": "Pod A",
            "type": "pod",
            "state": "active",
            "detail": "",
            "x": 34,
            "y": 194
          },
          {
            "id": "b",
            "label": "Pod B",
            "type": "pod",
            "state": "active",
            "detail": "",
            "x": 297,
            "y": 194
          },
          {
            "id": "c",
            "label": "Pod C",
