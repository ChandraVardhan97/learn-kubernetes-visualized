---
const {variant='lab'}=Astro.props;
---
{variant==='lab'?<svg class="cluster-sketch" viewBox="0 0 500 280" role="img" aria-labelledby="lab-topology-title lab-topology-desc"><title id="lab-topology-title">The local lab topology</title><desc id="lab-topology-desc">kubectl addresses one kind control-plane node, connected to two worker nodes on your computer.</desc>
 <g class="sketch-links" fill="none"><path d="M82 141H160M258 141H300V78H331M300 141V206H331"/><path d="m151 137 8 4-8 4m171-67 8 4-8 4m0 120 8 4-8 4"/></g>
 <text x="29" y="109" class="sketch-note">Your terminal</text><rect class="sketch-terminal" x="22" y="123" width="78" height="42" rx="8"/><text x="35" y="150" class="sketch-command">&gt;_</text>
 <rect class="sketch-node control" x="160" y="80" width="112" height="122" rx="12"/><g class="sketch-symbol"><path d="m204 105 12-7 12 7v14l-12 7-12-7Z"/><path d="M216 103v18m-8-13 16 9m-16 0 16-9"/></g><text x="216" y="151" text-anchor="middle">Control plane</text><text x="216" y="173" text-anchor="middle" class="sketch-note">API · scheduler</text><text x="216" y="188" text-anchor="middle" class="sketch-note">loops · etcd</text>
 {[50,178].map((y,i)=><g><rect class="sketch-node" x="332" y={y} width="138" height="83" rx="10"/><rect class="sketch-container" x="345" y={y+14} width="19" height="19" rx="4"/><rect class="sketch-container" x="369" y={y+14} width="19" height="19" rx="4"/><rect class="sketch-container quiet" x="393" y={y+14} width="19" height="19" rx="4"/><text x="346" y={y+58}>Worker {i+1}</text><circle class="sketch-ready" cx="450" cy={y+57} r="3"/></g>)}
 <text class="sketch-note" x="22" y="255">kind / kv-lab</text><text class="sketch-note" x="470" y="280" text-anchor="end">One disposable cluster. Three nodes.</text>
 </svg>:<svg class="path-sketch" viewBox="0 0 250 90" aria-hidden="true"><g fill="none" class="sketch-links"><path d={variant==='foundations'?'M43 44H110M145 44H215':variant==='intermediate'?'M35 44H100M125 44H195M195 44V20M195 44V68':'M30 44H96M123 44H190M190 44V20M190 44V68'}/></g>{variant==='foundations'?<><rect class="sketch-node control" x="10" y="22" width="42" height="44" rx="6"/><rect class="sketch-node" x="102" y="22" width="42" height="44" rx="6"/><rect class="sketch-container" x="200" y="13" width="21" height="21" rx="4"/><rect class="sketch-container" x="200" y="38" width="21" height="21" rx="4"/><rect class="sketch-container" x="200" y="63" width="21" height="21" rx="4"/></>:<><circle class="sketch-node control" cx="31" cy="44" r="18"/><rect class="sketch-node control" x="95" y="25" width="37" height="38" rx="7"/>{[9,56].map(y=><rect class="sketch-node" x="180" y={y} width="49" height="27" rx="5"/>)}</>}</svg>}
