---
import {render} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import LessonProgress from '../../../components/LessonProgress';
import {getLessons,lessonHref} from '../../../lib/content';
import {getModule,levelNames} from '../../../data/modules';
export async function getStaticPaths(){return (await getLessons()).map(lesson=>({params:{level:lesson.data.level,slug:lesson.id.split('/').pop()},props:{lesson}}));}
const {lesson}=Astro.props;
const {Content,headings}=await render(lesson);
const data=lesson.data;const all=await getLessons();const index=all.findIndex(l=>l.data.lessonId===data.lessonId);const previous=all[index-1],next=all[index+1];const module=getModule(data.module);
const prereqs=all.filter(l=>data.prerequisites.includes(l.data.lessonId));
---
<Base title={data.title} description={data.description} lessonId={data.lessonId}><div class="lesson-layout"><article data-pagefind-body data-pagefind-meta={`level:${levelNames[data.level]}`}>
 <header class="lesson-header"><div class="lesson-meta"><a href={`/curriculum/#${data.level}`}>{levelNames[data.level]}</a><span aria-hidden="true">/</span><a href={`/curriculum/#${data.module}`}>{module.title}</a><span>About {data.minutes} min</span></div><h1>{data.title}</h1><p class="lesson-lead">{data.description}</p><div class="lesson-objectives"><h2>What you will understand</h2><ul>{data.objectives.map(o=><li>{o}</li>)}</ul></div>{!!prereqs.length&&<p class="prerequisites">Builds on: {prereqs.map((p,i)=><>{i>0?', ':''}<a href={lessonHref(p)}>{p.data.title}</a></>)}</p>}</header>
 <div class="prose"><Content /></div>
 <section class="lesson-sources" id="sources"><h2>Go to the source</h2><ul>{data.sources.map(s=><li><a href={s.url} target="_blank" rel="noreferrer">{s.title} <span aria-hidden="true">↗</span></a></li>)}</ul><p>Reviewed {data.reviewed} · Kubernetes {data.kubernetesVersion} · <a href={`/labs/#${data.lab}`}>Related local exercise</a></p></section>
 <LessonProgress id={data.lessonId} client:visible />
 <nav class="lesson-next" aria-label="Adjacent lessons">{previous&&<a href={lessonHref(previous)}><small>Previous lesson</small>← {previous.data.title}</a>}{next&&<a href={lessonHref(next)} class="next"><small>Next lesson</small>{next.data.title} →</a>}</nav>
 </article><aside class="lesson-toc" aria-label="On this page"><p>In this lesson</p><ul>{headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul><div class="toc-sources"><a href="#sources">Official references ↗</a><p class="muted">Kubernetes {data.kubernetesVersion}</p><a href={`/labs/#${data.lab}`}>Try it locally →</a></div></aside></div></Base>
